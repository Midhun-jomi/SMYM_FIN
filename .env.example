# SMYM FIN — Environment Variables Example
# Duplicate this file to .env and fill in the values

# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Google Apps Script Web App Deployment URL (from Apps Script Deployment)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Environment mode ('development' or 'production')
VITE_APP_ENV=development
